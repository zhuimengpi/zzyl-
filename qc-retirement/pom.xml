<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 官方父工程，统一管理 Spring Boot 及大部分第三方依赖版本 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <!-- 父工程：仅负责聚合子模块与统一版本管理，不参与打包 -->
    <groupId>com.zhuimeng</groupId>
    <artifactId>qc-retirement</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>qc-retirement</name>
    <description>qc-retirement 父工程（聚合 + 依赖版本管理）</description>

    <!-- 聚合子模块 -->
    <modules>
        <!-- 公共实体/DTO 模块 -->
        <module>qc-pojo</module>
        <!-- 公共工具模块 -->
        <module>qc-util</module>
        <!-- 业务服务模块（可执行应用） -->
        <module>qc-service</module>
    </modules>

    <!-- 统一版本号：仅管理 Spring Boot BOM 未覆盖的第三方依赖版本 -->
    <properties>
        <java.version>21</java.version>

        <!-- MyBatis -->
        <mybatis-spring-boot.version>4.0.1</mybatis-spring-boot.version>

        <!-- 阿里云 OSS 及其 JAXB 附属 -->
        <aliyun-oss.version>3.18.4</aliyun-oss.version>
        <jaxb-api.version>2.3.1</jaxb-api.version>
        <activation.version>1.1.1</activation.version>
        <jaxb-runtime.version>2.3.3</jaxb-runtime.version>

        <!-- JWT -->
        <jjwt.version>0.9.1</jjwt.version>

        <!-- 工具 / 分页 / AI / 缓存 / JSON -->
        <hutool.version>5.7.17</hutool.version>
        <pagehelper.version>1.4.7</pagehelper.version>
        <dashscope.version>2.22.23</dashscope.version>
        <redisson.version>3.16.2</redisson.version>
        <fastjson.version>2.0.32</fastjson.version>
    </properties>

    <!-- 依赖版本统一管理：子模块声明依赖时无需再写 version -->
    <dependencyManagement>
        <dependencies>
            <!-- 内部模块：子模块引用时无需指定版本 -->
            <dependency>
                <groupId>com.zhuimeng</groupId>
                <artifactId>qc-pojo</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zhuimeng</groupId>
                <artifactId>qc-util</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- MyBatis 起步依赖 -->
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis-spring-boot.version}</version>
            </dependency>

            <!-- 阿里云 OSS -->
            <dependency>
                <groupId>com.aliyun.oss</groupId>
                <artifactId>aliyun-sdk-oss</artifactId>
                <version>${aliyun-oss.version}</version>
            </dependency>

            <!-- 阿里云 OSS 附属：JAXB / Activation -->
            <dependency>
                <groupId>javax.xml.bind</groupId>
                <artifactId>jaxb-api</artifactId>
                <version>${jaxb-api.version}</version>
            </dependency>
            <dependency>
                <groupId>javax.activation</groupId>
                <artifactId>activation</artifactId>
                <version>${activation.version}</version>
            </dependency>
            <dependency>
                <groupId>org.glassfish.jaxb</groupId>
                <artifactId>jaxb-runtime</artifactId>
                <version>${jaxb-runtime.version}</version>
            </dependency>

            <!-- JWT -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt</artifactId>
                <version>${jjwt.version}</version>
            </dependency>

            <!-- Hutool 工具库 -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- PageHelper 分页插件 -->
            <dependency>
                <groupId>com.github.pagehelper</groupId>
                <artifactId>pagehelper-spring-boot-starter</artifactId>
                <version>${pagehelper.version}</version>
            </dependency>

            <!-- 阿里云 DashScope AI -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>dashscope-sdk-java</artifactId>
                <version>${dashscope.version}</version>
            </dependency>

            <!-- Redisson -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>

            <!-- Fastjson -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>fastjson</artifactId>
                <version>${fastjson.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
